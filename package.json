{
  "name": "mapa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "pnpm generate && vite build",
    "build:vercel": "pnpm generate && vite build --mode vercel",
    "start": "node .output/server/index.mjs",
    "generate": "tsx scripts/openapi.ts && openapi-ts && oxfmt openapi.json src/generated",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test",
    "verify:artifact": "tsx scripts/verify-artifact.ts",
    "reconcile:astrolink": "tsx scripts/reconcile-astrolink.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.107",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/libre-caslon-display": "5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "ai": "7.0.159",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sweph": "2.10.3-8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "3.0.261029-rc",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "volta": {
    "node": "24.22.2"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sweph",
      "esbuild"
    ]
  }
}
