{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "src/generated/**",
    "src/routeTree.gen.ts",
    ".output/**",
    ".vercel/**",
    "prompt-files/**",
    "static/**",
    ".venv/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  }
}
